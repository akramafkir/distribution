# ── Supabase / PostgreSQL ────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
# IMPORTANT: use the TRANSACTION POOLER (port 6543), not the direct 5432 URL.
# Serverless functions open many short-lived connections; the direct port will
# exhaust the connection limit. Append ?sslmode=require.
DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# ── App auth ─────────────────────────────────────────────────────────────────
APP_PASSWORD="change-me-team-password"      # what the team types to log in
APP_TOKEN="change-me-long-random-secret"    # server secret; also signs supplier tokens

# ── Cron (bon d'achat 01:00) ─────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/po?action=run
CRON_SECRET="change-me-long-random-secret"
